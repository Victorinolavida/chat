SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000
DEBUG=true
SOCKETIO_PATH=/ws

# Database: SQLite (default) or Postgres (see docker-compose.yml)
DATABASE_URL=sqlite:///chat.db
# DATABASE_URL=postgresql+psycopg://chat:chat@localhost:5432/chat

# Object storage (Silo, S3-compatible; see docker-compose.yml)
SILO_ENDPOINT=http://localhost:9000
SILO_ACCESS_KEY=admin
SILO_SECRET_KEY=adminadmin
SILO_BUCKET=chat

# docker-compose service credentials (override to match DATABASE_URL/SILO_*)
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
POSTGRES_PORT=5432
SILO_ROOT_USER=admin
SILO_ROOT_PASSWORD=adminadmin
SILO_PORT=9000
SILO_CONSOLE_PORT=9001
